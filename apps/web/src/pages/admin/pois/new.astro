---
import { env } from 'cloudflare:workers';
import { requireAdminSession } from '../../../lib/admin-auth.js';
import { listGlobalPOIs } from '@itsaydrian/waymark-shared/lib';
import TripLayout from '../../../layouts/TripLayout.astro';
import AdminNavbar from '../../../components/AdminNavbar.astro';

const redirect = await requireAdminSession(Astro.request, env.COOKIE_SIGNING_SECRET);
if (redirect) return redirect;

const pois = await listGlobalPOIs(env.TRIPS);
const cities = [...new Set(pois.map(p => p.city))].sort();
---
<TripLayout title="Admin — New Global POI">
  <AdminNavbar currentPage="pois" />
  <div class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-xl font-bold mb-6">New Global POI</h1>

    <form id="new-poi-form" class="flex flex-col gap-4">
      <div>
        <label class="block text-xs uppercase tracking-wide text-[var(--color-text-secondary)] mb-1">
          Name <span class="text-red-400">*</span>
        </label>
        <input name="name" required
          class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-sm focus:outline-none focus:border-blue-500 min-h-[44px]"
          placeholder="Eiffel Tower" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs uppercase tracking-wide text-[var(--color-text-secondary)] mb-1">
            City <span class="text-red-400">*</span>
          </label>
          <input name="city" required list="city-options"
            class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-sm focus:outline-none focus:border-blue-500 min-h-[44px]"
            placeholder="Paris" />
          <datalist id="city-options">
            {cities.map(city => <option value={city} />)}
          </datalist>
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wide text-[var(--color-text-secondary)] mb-1">
            Category <span class="text-red-400">*</span>
          </label>
          <select name="category" required
            class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-sm focus:outline-none focus:border-blue-500 min-h-[44px]">
            <option value="">Select category...</option>
            <option value="restaurant">Restaurant</option>
            <option value="attraction">Attraction</option>
            <option value="shop">Shop</option>
            <option value="outdoor">Outdoor</option>
            <option value="entertainment">Entertainment</option>
            <option value="other">Other</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs uppercase tracking-wide text-[var(--color-text-secondary)] mb-1">
          Address
        </label>
        <input name="address"
          class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-sm focus:outline-none focus:border-blue-500 min-h-[44px]"
          placeholder="Champ de Mars, 5 Av. Anatole France" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs uppercase tracking-wide text-[var(--color-text-secondary)] mb-1">
            Latitude
          </label>
          <input name="lat" type="number" step="any"
            class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-sm focus:outline-none focus:border-blue-500 min-h-[44px]"
            placeholder="48.8584" />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wide text-[var(--color-text-secondary)] mb-1">
            Longitude
          </label>
          <input name="lng" type="number" step="any"
            class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-sm focus:outline-none focus:border-blue-500 min-h-[44px]"
            placeholder="2.2945" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs uppercase tracking-wide text-[var(--color-text-secondary)] mb-1">
            Website
          </label>
          <input name="website" type="url"
            class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-sm focus:outline-none focus:border-blue-500 min-h-[44px]"
            placeholder="https://..." />
        </div>
        <div>
          <label class="block text-xs uppercase tracking-wide text-[var(--color-text-secondary)] mb-1">
            Google Maps URL
          </label>
          <input name="googleMapsUrl" type="url"
            class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-sm focus:outline-none focus:border-blue-500 min-h-[44px]"
            placeholder="https://maps.google.com/..." />
          <p id="maps-url-status" class="hidden text-xs mt-1"></p>
        </div>
      </div>

      <div>
        <label class="block text-xs uppercase tracking-wide text-[var(--color-text-secondary)] mb-1">
          Description
        </label>
        <textarea name="description" rows="3"
          class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-sm focus:outline-none focus:border-blue-500 resize-none min-h-[44px]"
          placeholder="Brief description of the place..."></textarea>
      </div>

      <div>
        <label class="block text-xs uppercase tracking-wide text-[var(--color-text-secondary)] mb-1">
          Advisor Notes <span class="text-[var(--color-text-muted)]">(visible to all trips using this POI)</span>
        </label>
        <textarea name="advisorNotes" rows="2"
          class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-sm focus:outline-none focus:border-blue-500 resize-none min-h-[44px]"
          placeholder="Internal notes, recommendations, tips..."></textarea>
      </div>

      <div class="pt-2">
        <button type="submit"
          class="px-5 py-2 bg-blue-600 hover:bg-blue-700 disabled:opacity-50 text-white text-sm font-medium rounded-lg transition-colors min-h-[44px]">
          Create Global POI
        </button>
      </div>
    </form>
    <p id="form-status" class="text-sm mt-3 hidden"></p>
  </div>

  <script>
    import { showToast } from '../../../lib/toast.js';
    import { parseGoogleMapsUrl } from '../../../lib/maps-url.js';
    const form = document.getElementById('new-poi-form') as HTMLFormElement;
    const formStatus = document.getElementById('form-status')!;
    const submitBtn = form.querySelector('button[type=submit]') as HTMLButtonElement;

    async function doCreate(force: boolean) {
      submitBtn.disabled = true;
      formStatus.classList.add('hidden');

      const formData = new FormData(form);
      const payload = Object.fromEntries(
        Array.from(formData.entries()).map(([k, v]) => [k, v || undefined]).filter(([_, v]) => v !== undefined)
      );

      try {
        const res = await fetch('/api/admin/pois', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Force-Create': force ? '1' : '0',
          },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (res.ok) {
          window.location.href = '/admin/pois';
        } else if (res.status === 409 && data.error === 'duplicate') {
          showToast(data.message, 'warn');
          submitBtn.disabled = false;
        } else {
          formStatus.textContent = data.error || 'Failed to create POI';
          formStatus.className = 'text-sm text-red-400';
          formStatus.classList.remove('hidden');
          submitBtn.disabled = false;
        }
      } catch {
        formStatus.textContent = 'Network error';
        formStatus.className = 'text-sm text-red-400';
        formStatus.classList.remove('hidden');
        submitBtn.disabled = false;
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      doCreate(false);
    });

    const mapsUrlInput = form.querySelector<HTMLInputElement>('[name="googleMapsUrl"]')!;
    const mapsUrlStatus = document.getElementById('maps-url-status')!;

    mapsUrlInput.addEventListener('blur', async () => {
      const url = mapsUrlInput.value.trim();
      if (!url) { mapsUrlStatus.className = 'hidden text-xs mt-1'; return; }
      const result = await parseGoogleMapsUrl(url);
      if (result) {
        (form.querySelector<HTMLInputElement>('[name="lat"]')!).value = String(result.lat);
        (form.querySelector<HTMLInputElement>('[name="lng"]')!).value = String(result.lng);
        const nameInput = form.querySelector<HTMLInputElement>('[name="name"]')!;
        if (result.nameSlug && !nameInput.value.trim()) nameInput.value = result.nameSlug;
        mapsUrlStatus.textContent = '✓ Coordinates found';
        mapsUrlStatus.className = 'text-xs mt-1 text-green-400';
      } else {
        mapsUrlStatus.textContent = "Couldn't parse that Maps link";
        mapsUrlStatus.className = 'text-xs mt-1 text-amber-400';
      }
    });

    mapsUrlInput.addEventListener('input', () => {
      mapsUrlStatus.className = 'hidden text-xs mt-1';
    });
  </script>
</TripLayout>
